// StreamKnife 配置文件
// 修改后重启程序生效
//
// close_action  : "ask" (每次询问) | "quit" (直接退出) | "minimize" (最小化到托盘)
// save_path     : 快速保存目录，留空则保存到程序所在目录
// window_width  : 窗口初始宽度 (像素)，用户可自定义
// window_height : 窗口初始高度 (像素)，用户可自定义
//                 注意：窗口高度会随所选插件的参数控件自动调整，此值仅决定启动时的初始大小
{
  "close_action": "ask",
  "save_path": ".\\",
  "window_width": 800,
  "window_height": 600
}
